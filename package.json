{
  "name": "pullup-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-pwa-icons.mjs && vue-tsc -b && vite build",
    "sync:icons": "node scripts/sync-pwa-icons.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots:readme": "UPDATE_README_SCREENSHOTS=1 playwright test e2e/readme-screenshots.spec.ts --project='Mobile Chrome' && node scripts/build-app-screenshots-svg.mjs",
    "audit:science": "node scripts/audit-science-crosswalk.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8",
    "wait-on": "^9.1.0"
  }
}
